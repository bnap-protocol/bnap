 "bnapCases": 1,
 "area": "tlv",
 "title": "TLV streams, the even/odd rule, entry lists and base64url",
 "schema": "schema/tlv.schema.json",
 "generator": "conformance/gen_cases.py",
 "source": "spec/socket-draft-00.md (doc rev 39), spec/ERRATA.md, spec/DECISIONS.md, registry/generated/registry.json, reference/python/bnap_ref.py",
 "numberOfTests": 53,
 "header": [
  "TLV streams are BOLT 1 records with strictly increasing types (draft-00 section 2).",
  "A receiver MUST reject an unknown even type as MALFORMED and MUST ignore an unknown odd",
  "type. Nested streams use only 0-239, the experimental range and GREASE. Objects in the",
  "EvenOddRule group are complete and correctly signed, so the type is the only question."
 ],
 "notes": {
  "Valid": {
   "bugType": "BASIC",
   "description": "A well-formed input every implementation must accept."
  },
  "Order": {
   "bugType": "MALFORMED",
   "description": "Types not strictly increasing."
  },
  "Duplicate": {
   "bugType": "MALFORMED",
   "description": "The same type twice."
  },
  "Truncated": {
   "bugType": "MALFORMED",
   "description": "A length that runs past the end of the buffer."
  },
  "NonMinimal": {
   "bugType": "MALFORMED",
   "description": "A non-minimal BigSize for a type or a length."
  },
  "UnknownEven": {
   "bugType": "MALFORMED",
   "description": "An unknown even type."
  },
  "UnknownOdd": {
   "bugType": "BASIC",
   "description": "An unknown odd type, which a receiver ignores."
  },
  "Grease": {
   "bugType": "BASIC",
   "description": "A GREASE record: odd, 3,000,000,001 to 3,000,000,999."
  },
  "NestedRange": {
   "bugType": "EDGE",
   "description": "A nested record outside 0-239, experimental and GREASE. draft-00 says nested streams use only those ranges but names no error for an odd type outside them, so rejecting or ignoring it are both acceptable; bnap_conf rejects."
  },
  "Base64": {
   "bugType": "MALFORMED",
   "description": "Not canonical unpadded base64url."
  }
 },
