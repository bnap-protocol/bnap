{
 "bnapCases": 1,
 "area": "outcomes",
 "title": "Commit, replay, settle and timeout as state-machine traces",
 "schema": "schema/outcomes.schema.json",
 "generator": "conformance/gen_cases.py",
 "source": "spec/socket-draft-00.md (doc rev 39), spec/ERRATA.md, spec/DECISIONS.md, registry/generated/registry.json, reference/python/bnap_ref.py",
 "numberOfTests": 21,
 "header": [
  "Each case is a trace of operations on one use store (draft-00 6.3 and 6.4). A conformant",
  "store returns, for every step, what that step's expect says. commit returns New, Replay",
  "(with the recorded status), SPENT, RATE_LIMITED or UNAVAILABLE; gate names what the gate",
  "then does. IDs are labels unless the case computes them from the socket formulas. A case",
  "is invalid when its last commit is refused, with that refusal as its error."
 ],
 "notes": {
  "Valid": {
   "bugType": "BASIC",
   "description": "A well-formed input every implementation must accept."
  },
  "Replay": {
   "bugType": "BASIC",
   "description": "The same credential for the same request finds its outcome."
  },
  "Spent": {
   "bugType": "SPENT",
   "description": "A single use ID already committed under another ReplayKey."
  },
  "Abort": {
   "bugType": "BASIC",
   "description": "An aborted commit consumes nothing."
  },
  "Rate": {
   "bugType": "RATE_LIMITED",
   "description": "A counter is full."
  },
  "Once": {
   "bugType": "BASIC",
   "description": "The status changes exactly once, from PENDING, and never flips on replay."
  },
  "Timeout": {
   "bugType": "BASIC",
   "description": "PENDING past pending_timeout becomes FAILED, with counters given back."
  },
  "Purge": {
   "bugType": "BASIC",
   "description": "After replay_window the outcome may go; single uses stay."
  },
  "Unavailable": {
   "bugType": "UNAVAILABLE",
   "description": "The store cannot be reached: fail closed."
  },
  "SharedRail": {
   "bugType": "SPENT",
   "description": "One payment presented through two schemes admits one action."
  },
  "ReceiptOnly": {
   "bugType": "BASIC",
   "description": "The carrier kept no response: the receipt alone, with the recorded scheme_result."
  },
  "Window": {
   "bugType": "POLICY",
   "description": "A credential with no single-use ID whose offer outlives its outcome record. draft-00 names no code for this refusal; POLICY is used, others are acceptable."
  }
 },
 "testGroups": [
