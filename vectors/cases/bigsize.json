 "numberOfTests": 41,
 "header": [
  "BigSize is the variable-length unsigned integer of BOLT 1 (draft-00 section 2).",
  "tu64 is a big-endian u64 with leading zero bytes removed; zero is the empty string.",
  "Non-minimal encodings of either are MALFORMED. Values are decimal strings so that",
  "64-bit values survive JSON parsers limited to 2^53."
 ],
 "notes": {
  "Valid": {
   "bugType": "BASIC",
   "description": "A well-formed input every implementation must accept."
  },
  "NonMinimal": {
   "bugType": "MALFORMED",
   "description": "A value written in more bytes than its minimal encoding."
  },
  "Truncated": {
   "bugType": "MALFORMED",
   "description": "The buffer ends inside the integer."
  },
  "TrailingBytes": {
   "bugType": "MALFORMED",
   "description": "Bytes left after exactly one integer was read."
  }
 },
