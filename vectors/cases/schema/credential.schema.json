{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/bnap-protocol/bnap/vectors/cases/schema/credential.schema.json",
 "title": "BNAP conformance cases: The Credential, its envelope and the identifiers",
 "type": "object",
 "required": [
  "bnapCases",
  "area",
  "title",
  "schema",
  "generator",
  "source",
  "numberOfTests",
  "header",
  "notes",
  "testGroups"
 ],
 "additionalProperties": false,
 "properties": {
  "bnapCases": {
   "const": 1
  },
  "area": {
   "const": "credential"
  },
  "title": {
   "type": "string"
  },
  "schema": {
   "const": "schema/credential.schema.json"
  },
  "generator": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "numberOfTests": {
   "type": "integer"
  },
  "header": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "notes": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "bugType",
     "description"
    ],
    "additionalProperties": false,
    "properties": {
     "bugType": {
      "type": "string"
     },
     "description": {
      "type": "string"
     }
    }
   }
  },
  "testGroups": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "type",
       "section",
       "description",
       "tests"
      ],
      "additionalProperties": false,
      "properties": {
       "type": {
        "enum": [
         "CredentialParse",
         "Envelope",
         "UseId",
         "RailId",
         "CounterKeys",
         "NativeEnvelope",
         "WitnessOverDigest",
         "ValueCredentialCount"
        ]
       },
       "section": {
        "type": "string"
       },
       "description": {
        "type": "string"
       },
       "tests": {
        "type": "array"
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "CredentialParse"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "credential",
               "max_credential",
               "carrier"
              ],
              "properties": {
               "credential": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "max_credential": {
                "type": "integer"
               },
               "carrier": {
                "enum": [
                 "http",
                 "none"
                ]
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "Envelope"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "offer_id",
               "action_scope",
               "pay_scheme",
               "attest_schemes",
               "ext",
               "binding",
               "pay_body",
               "attest_bodies",
               "ids"
              ],
              "properties": {
               "offer_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "action_scope": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "pay_scheme": {
                "anyOf": [
                 {
                  "type": "string"
                 },
                 {
                  "type": "null"
                 }
                ]
               },
               "attest_schemes": {
                "type": "array"
               },
               "ext": {
                "anyOf": [
                 {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                 },
                 {
                  "type": "null"
                 }
                ]
               },
               "binding": {
                "anyOf": [
                 {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                 },
                 {
                  "type": "null"
                 }
                ]
               },
               "pay_body": {
                "anyOf": [
                 {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                 },
                 {
                  "type": "null"
                 }
                ]
               },
               "attest_bodies": {
                "type": "array"
               },
               "ids": {
                "type": "array"
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "UseId"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "scheme",
               "local"
              ],
              "properties": {
               "scheme": {
                "type": "string"
               },
               "local": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "RailId"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "kind",
               "fields"
              ],
              "properties": {
               "kind": {
                "type": "string"
               },
               "fields": {
                "type": "object"
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "CounterKeys"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "kind",
               "use_id",
               "limit",
               "epoch",
               "now"
              ],
              "properties": {
               "kind": {
                "enum": [
                 "rate",
                 "quota"
                ]
               },
               "use_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "limit": {
                "type": "integer"
               },
               "epoch": {
                "type": "integer"
               },
               "now": {
                "type": "integer"
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "NativeEnvelope"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "offer_id",
               "action_scope",
               "scheme",
               "native_bytes"
              ],
              "properties": {
               "offer_id": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "action_scope": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "scheme": {
                "type": "string"
               },
               "native_bytes": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "WitnessOverDigest"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "credential",
               "action_scope",
               "witness_key",
               "cache"
              ],
              "properties": {
               "credential": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "action_scope": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "witness_key": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
               },
               "cache": {
                "type": "object"
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "type": {
         "const": "ValueCredentialCount"
        }
       },
       "required": [
        "type"
       ]
      },
      "then": {
       "properties": {
        "tests": {
         "type": "array",
         "items": {
          "allOf": [
           {
            "$ref": "#/$defs/test"
           },
           {
            "properties": {
             "inputs": {
              "type": "object",
              "required": [
               "bnap_pay",
               "bnap_attest_only",
               "native"
              ],
              "properties": {
               "bnap_pay": {
                "type": "boolean"
               },
               "bnap_attest_only": {
                "type": "boolean"
               },
               "native": {
                "type": "array"
               }
              },
              "additionalProperties": false
             }
            }
           }
          ]
         }
        }
       }
      }
     }
    ]
   }
  }
 },
 "$defs": {
  "test": {
   "type": "object",
   "required": [
    "tcId",
    "comment",
    "flags",
    "sections",
    "inputs",
    "result"
   ],
   "additionalProperties": false,
   "properties": {
    "tcId": {
     "type": "integer"
    },
    "comment": {
     "type": "string",
     "minLength": 1
    },
    "flags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "sections": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "inputs": {
     "type": "object"
    },
    "result": {
     "enum": [
      "valid",
      "invalid",
      "acceptable"
     ]
    },
    "error": {
     "enum": [
      "VERSION",
      "MALFORMED",
      "TOO_LARGE",
      "BAD_OFFER",
      "STALE",
      "WRONG_SCOPE",
      "NOT_OFFERED",
      "POLICY",
      "UNDERPAID",
      "BAD_CREDENTIAL",
      "BINDING",
      "SPENT",
      "PENDING",
      "RATE_LIMITED",
      "UNAVAILABLE",
      "REQUIRED",
      "CLIENT_REJECT",
      "MANIFEST_REJECT"
     ]
    },
    "errorCode": {
     "type": "integer"
    },
    "acceptableErrors": {
     "type": "array",
     "items": {
      "enum": [
       "VERSION",
       "MALFORMED",
       "TOO_LARGE",
       "BAD_OFFER",
       "STALE",
       "WRONG_SCOPE",
       "NOT_OFFERED",
       "POLICY",
       "UNDERPAID",
       "BAD_CREDENTIAL",
       "BINDING",
       "SPENT",
       "PENDING",
       "RATE_LIMITED",
       "UNAVAILABLE",
       "REQUIRED"
      ]
     }
    },
    "reason": {
     "type": "string"
    },
    "expected": {
     "type": "object"
    }
   },
   "if": {
    "properties": {
     "result": {
      "const": "invalid"
     }
    },
    "required": [
     "result"
    ]
   },
   "then": {
    "required": [
     "error"
    ]
   }
  }
 }
}
