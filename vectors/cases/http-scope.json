{
 "bnapCases": 1,
 "area": "http-scope",
 "title": "HTTP scopes and route matching",
 "schema": "schema/http-scope.schema.json",
 "generator": "conformance/gen_cases.py",
 "source": "spec/socket-draft-00.md (doc rev 39), spec/ERRATA.md, spec/DECISIONS.md, registry/generated/registry.json, reference/python/bnap_ref.py",
 "numberOfTests": 31,
 "header": [
  "action scope = H_bnap/scope/http(lp(method) || lp(target) || lp(content hash, or empty) ||",
  "BigSize(h) || lp(name) || lp(value) ...); target = manifest origin + request-target as received",
  "(draft-00 10.1). Several cases differ from a neighbour in one byte of input, and their",
  "scopes differ: no normalization of any kind."
 ],
 "notes": {
  "Valid": {
   "bugType": "BASIC",
   "description": "A well-formed input every implementation must accept."
  },
  "NoNormalization": {
   "bugType": "BASIC",
   "description": "The input differs from a neighbour only in a form normalization would hide; the scope differs."
  },
  "HeaderCombine": {
   "bugType": "EDGE",
   "description": "Repeated fields are combined as RFC 9110 5.3 describes. draft-00 does not fix the separator bytes; these cases use a comma and one space."
  },
  "Ambiguous": {
   "bugType": "EDGE",
   "description": "draft-00 does not settle whether /v1/* matches /v1 itself."
  }
 },
