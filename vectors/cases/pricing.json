{
 "bnapCases": 1,
 "area": "pricing",
 "title": "Pricing, admission and metering",
 "schema": "schema/pricing.schema.json",
 "generator": "conformance/gen_cases.py",
 "source": "spec/socket-draft-00.md (doc rev 39), spec/ERRATA.md, spec/DECISIONS.md, registry/generated/registry.json, reference/python/bnap_ref.py",
 "numberOfTests": 47,
 "header": [
  "price() and admit of draft-00 section 7, in offer order. Each attestation lists whether it",
  "verified and, for a quota, whether its counter has room. Admission for a credential without",
  "pay prices from any positive base (see the NoPayBase note): only a waive, a 10,000 bp discount",
  "or a quota with room bring it to 0. Class None value schemes are admissible only at price 0",
  "(DECISIONS row 25)."
 ],
 "notes": {
  "Valid": {
   "bugType": "BASIC",
   "description": "A well-formed input every implementation must accept."
  },
  "Multiply": {
   "bugType": "BASIC",
   "description": "Discounts multiply and each step rounds the amount taken off down."
  },
  "OrderMatters": {
   "bugType": "EDGE",
   "description": "Rounding makes the result depend on order: the offer's order rules."
  },
  "Quota": {
   "bugType": "BASIC",
   "description": "A quota applies only while p > 0, the first verified one with room."
  },
  "Policy": {
   "bugType": "POLICY",
   "description": "A required attestation did not verify."
  },
  "Underpaid": {
   "bugType": "UNDERPAID",
   "description": "Value below the effective price."
  },
  "NoPayBase": {
   "bugType": "EDGE",
   "description": "draft-00 7 writes price(entry.amount, or 0 if the credential has no pay), which makes its own 'p > 0 and no pay' check unreachable and would admit any attestation-only credential for free. These cases price a credential without pay from a positive base; a waive, a 10,000 bp discount or a quota with room admit it, nothing else does. Reported as an erratum candidate."
  },
  "Overpayment": {
   "bugType": "BASIC",
   "description": "Value above the price is admitted; a scheme that can return change does."
  },
  "Metering": {
   "bugType": "BASIC",
   "description": "charged = min(price(ceil(units x rate / 1000)), price(amount)), exactly."
  },
  "ClassRule": {
   "bugType": "MALFORMED",
   "description": "An offer no gate may build."
  }
 },
